# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where portfolio contact messages should be delivered
CONTACT_TO_EMAIL=you@example.com

# Use a verified Resend domain for production, for example:
# Portfolio <hello@yourdomain.com>
# For initial testing, Resend may allow onboarding@resend.dev with account restrictions.
RESEND_FROM_EMAIL=Portfolio <hello@yourdomain.com>

# Optional comma-separated list of additional origins allowed to call /api/contact.
# Same-origin requests are always accepted.
# CONTACT_ALLOWED_ORIGINS=https://www.example.com,https://example.com
